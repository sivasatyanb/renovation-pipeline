# Gemini API Key (Required for live research mode; never commit real keys)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model / Agent Configuration (Confirmed working via spike_gemini.py; never hardcode in code)
DEEP_RESEARCH_AGENT=deep-research-preview-04-2026
STRUCTURING_MODEL=gemini-4-argon
FALLBACK_MODEL=gemini-3.8-flash

# Voice Bargaining & Meeting Scheduling Configuration
TALK_MODEL=gemini-3.8-flash
TTS_MODEL=gemini-3.8-flash-tts
BUYER_VOICE=Kore
SELLER_VOICE=Puck
CALL_LANGUAGE=en-US
MAX_CALL_TURNS=10
CALL_TIMEOUT_SECONDS=120
CALL_REPLAY=false
CALENDAR_TIMEZONE=Europe/Paris
INVITE_ALLOWLIST=
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Design Studio & Rendering Configuration
RENDER_PLAN_MODEL=gemini-3.8-flash
IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_FALLBACK_MODEL=gemini-3.1-flash-image
RENDER_REPLAY=false

# Demo Mode (Set to true to simulate phases in ~10s and return /shared/fixtures/demo_result.json)
DEMO_MODE=true

# Local Development CORS Origins (Comma-separated list and optional regex for dynamic localhost ports)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080,http://10.0.2.2:8000
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|10\.0\.2\.2)(:\d+)?$

# Polling & Verification Timeouts
DEEP_RESEARCH_POLL_INTERVAL_SECONDS=10
DEEP_RESEARCH_TIMEOUT_SECONDS=600
PHONE_VERIFY_TIMEOUT_SECONDS=5.0
