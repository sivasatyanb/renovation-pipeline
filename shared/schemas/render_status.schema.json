{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renovai.local/schemas/render_status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "phase", "is_replay", "result", "warnings", "error"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["queued", "running", "completed", "failed"]
    },
    "phase": {
      "type": ["string", "null"],
      "enum": ["planning", "rendering", "narrating", "done", null]
    },
    "is_replay": {
      "type": "boolean"
    },
    "result": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "before_url",
            "after_url",
            "renovation_prompt",
            "voice_confirmation",
            "audio_url",
            "model_used",
            "latency_ms",
            "room",
            "style",
            "work_items"
          ],
          "properties": {
            "before_url": { "type": "string" },
            "after_url": { "type": "string" },
            "renovation_prompt": { "type": "string" },
            "voice_confirmation": { "type": "string" },
            "audio_url": { "type": ["string", "null"] },
            "model_used": { "type": "string" },
            "latency_ms": { "type": "integer", "minimum": 0 },
            "room": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "surface_m2", "confidence"],
              "properties": {
                "type": { "type": "string", "minLength": 1 },
                "surface_m2": { "type": "number", "minimum": 0 },
                "confidence": {
                  "type": "string",
                  "enum": ["low", "medium", "high"]
                }
              }
            },
            "style": { "type": "string", "minLength": 1 },
            "work_items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["trade", "description", "quantity", "unit"],
                "properties": {
                  "trade": { "type": "string", "minLength": 1 },
                  "description": { "type": "string", "minLength": 1 },
                  "quantity": { "type": "number", "minimum": 0 },
                  "unit": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "error": {
      "type": ["string", "null"]
    }
  }
}
